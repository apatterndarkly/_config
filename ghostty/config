window-height = 5000
window-width = 5000
window-padding-x = 4
window-padding-y = 4
background-opacity = 0.20
window-decoration = false

scrollback-limit = 1000000000

font-family = D2CodingLigature Nerd Font Mono
font-synthetic-style = true
font-size = 14
adjust-cell-height = 60%
keybind = ctrl+left_bracket=text:\x1b
copy-on-select = true
focus-follows-mouse = false

minimum-contrast = 1

shell-integration = detect
command = /home/apd/.cargo/bin/nu

