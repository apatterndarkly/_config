layout {
    tab hide_floating_panes=true {
        pane split_direction="vertical" size="100%" command="nu" focus=true
        floating_panes {
            pane {
                x "10%"
                y "10%"
                height "80%"
                width "80%"
                command "bash"
            }
        }
        pane size=1 borderless=true {
    				plugin location="zellij:status-bar"
        }
    }
}
